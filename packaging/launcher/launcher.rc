// OAK box.exe's icon and version (packaging/launcher/launcher.c). VERSION and VERSION_STR come from build_bundle.sh.
#include <winver.h>

1 ICON "../oakbox.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION
PRODUCTVERSION VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "OAK box"
      VALUE "FileDescription", "OAK box"
      VALUE "FileVersion", VERSION_STR
      VALUE "InternalName", "OAK box"
      VALUE "OriginalFilename", "OAK box.exe"
      VALUE "ProductName", "OAK box"
      VALUE "ProductVersion", VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
