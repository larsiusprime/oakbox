{
  "name": "oakbox-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wording": "vite --mode wordingedit",
    "build": "node scripts/wording-types.mjs --check && tsc --noEmit && vite build && node scripts/no-wording-edit.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src && eslint src",
    "format": "biome format --write src",
    "api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "wording:types": "node scripts/wording-types.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@math.gl/polygon": "^4.1.0",
    "@tanstack/react-query": "^5.104.5",
    "intl-messageformat": "12.1.4",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.15",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
