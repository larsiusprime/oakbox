    "required": [
     "name",
     "country",
     "region",
     "jurisdiction",
     "tax_year",
     "valuation_date",
     "units"
    ],
    "title": "NewProject",
    "description": "What the user enters to create a project (SPEC \u00a73.0 F1)."
   },
