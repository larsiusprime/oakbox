     "folder": {
      "type": "string",
      "title": "Folder"
     },
     "files": {
      "items": {
       "$ref": "#/components/schemas/InputFile"
      },
      "type": "array",
      "title": "Files"
     }
    },
    "type": "object",
    "required": [
     "project",
     "folder",
     "files"
    ],
    "title": "ProjectDetail"
   },
   "Region": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code"
     },
     "name": {
      "type": "string",
      "title": "Name"
     }
    },
    "type": "object",
    "required": [
     "code",
     "name"
    ],
    "title": "Region"
   },
   "Regions": {
    "properties": {
     "countries": {
      "items": {
       "$ref": "#/components/schemas/Region"
      },
      "type": "array",
      "title": "Countries"
     },
     "subdivisions": {
      "additionalProperties": {
       "items": {
        "$ref": "#/components/schemas/Region"
       },
       "type": "array"
      },
      "type": "object",
      "title": "Subdivisions"
     }
    },
    "type": "object",
    "required": [
     "countries",
     "subdivisions"
