      "title": "Valuation Date"
     },
     "units": {
      "type": "string",
      "enum": [
       "imperial",
       "metric"
      ],
      "title": "Units",
      "default": "imperial"
     },
     "sample": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sample"
     },
     "files": {
      "items": {
       "$ref": "#/components/schemas/DataFile"
      },
      "type": "array",
      "title": "Files",
      "description": "data.load entries (SPEC \u00a73.0 F2)."
     }
    },
    "type": "object",
    "required": [
     "id",
     "name",
     "created_at",
     "country",
     "region",
     "jurisdiction",
     "tax_year",
     "valuation_date",
     "units",
     "sample",
     "files"
    ],
    "title": "Project"
   },
   "ProjectDetail": {
    "properties": {
     "project": {
      "$ref": "#/components/schemas/Project"
