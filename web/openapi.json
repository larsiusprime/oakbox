    "properties": {
     "path": {
      "type": "string",
      "title": "Path"
     },
     "problem": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Problem"
     },
     "format": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Format"
     },
     "size_bytes": {
      "type": "integer",
      "title": "Size Bytes",
      "default": 0
     },
     "files": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Files",
      "description": "Files that move or copy together (shapefile sidecars)."
     },
     "layers": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Layers",
      "description": "GeoPackage layers."
     },
     "suggested_name": {
      "type": "string",
      "title": "Suggested Name",
      "default": ""
     },
     "filename": {
      "type": "string",
      "title": "Filename",
      "description": "Its name in in/.",
      "default": ""
     },
     "already_in_project": {
      "type": "boolean",
      "title": "Already In Project",
      "description": "The file is already in this project's in/.",
      "default": false
     },
     "filename_taken": {
      "type": "boolean",
      "title": "Filename Taken",
      "description": "in/ already has a different file of this name.",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "path",
     "problem",
     "format",
     "size_bytes",
     "files",
     "layers",
     "suggested_name",
     "filename",
     "already_in_project",
     "filename_taken"
    ],
    "title": "FileCheck",
    "description": "What OAK box can tell about a file before adding it, without reading its data."
