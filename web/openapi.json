 "components": {
  "schemas": {
   "AddFile": {
    "properties": {
     "path": {
      "type": "string",
      "title": "Path"
     },
     "mode": {
      "type": "string",
      "enum": [
       "move",
       "copy"
      ],
      "title": "Mode"
     },
     "name": {
      "type": "string",
      "title": "Name",
      "description": "The data.load key."
     },
     "layer": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Layer"
     },
     "filename": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Filename",
      "description": "A new name in in/, when the original is taken."
     }
    },
    "type": "object",
    "required": [
     "path",
     "mode",
     "name"
    ],
    "title": "AddFile"
   },
   "AppSettingsView": {
    "properties": {
     "storage_location": {
      "type": "string",
      "title": "Storage Location"
     },
     "default_storage_location": {
      "type": "string",
      "title": "Default Storage Location"
     },
     "display": {
      "$ref": "#/components/schemas/Display-Output"
     }
    },
    "type": "object",
    "required": [
     "storage_location",
     "default_storage_location",
     "display"
    ],
    "title": "AppSettingsView"
   },
   "Column": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "type": {
      "type": "string",
      "enum": [
       "text",
       "number",
       "yes/no",
       "date",
       "geometry"
      ],
      "title": "Type",
      "description": "The column's own type in the file."
     },
     "samples": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Samples",
      "description": "A few distinct non-blank values from the first rows."
     },
     "date_format": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Date Format",
      "description": "The first common format that reads every sample, for text columns."
     }
    },
    "type": "object",
    "required": [
     "name",
     "type",
     "samples",
     "date_format"
    ],
    "title": "Column"
   },
   "DataFile": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name",
      "description": "The data.load key."
     },
     "filename": {
      "type": "string",
      "title": "Filename",
      "description": "File name inside in/."
     },
     "layer": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Layer",
      "description": "GeoPackage layer."
     },
     "load": {
      "additionalProperties": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "type": "object",
      "title": "Load",
      "description": "data.load.<name>.load: field -> [column] or [column, type] or [column, type, extra] (F3c)."
     }
    },
    "type": "object",
    "required": [
     "name",
     "filename",
     "layer",
     "load"
    ],
    "title": "DataFile",
    "description": "One data.load entry, as OAK box wrote it."
   },
   "DateCheck": {
    "properties": {
     "parsed": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "type": "array",
      "title": "Parsed",
      "description": "Each sample as read with the format (ISO date), or null."
     }
    },
    "type": "object",
    "required": [
     "parsed"
    ],
    "title": "DateCheck"
   },
   "DateFormatCheck": {
    "properties": {
     "samples": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Samples"
     },
     "format": {
      "type": "string",
      "title": "Format"
     }
    },
    "type": "object",
    "required": [
     "samples",
     "format"
    ],
    "title": "DateFormatCheck"
   },
   "DictionaryField": {
    "properties": {
     "key": {
      "type": "string",
      "title": "Key"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "description": {
      "type": "string",
      "title": "Description"
     },
     "type": {
      "type": "string",
      "title": "Type"
     },
     "groups": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Groups"
     },
     "source": {
      "type": "string",
      "enum": [
       "input",
       "derived",
       "either",
       "reserved"
      ],
      "title": "Source",
      "description": "input: only from your data; derived: always computed by OpenAVMKit; either: computed when missing; reserved: a name kept for a field OpenAVMKit means to compute (\u00a77 B11)."
     },
     "offered": {
      "type": "boolean",
      "title": "Offered",
      "description": "Listed in the Field dropdown (SPEC F3c)."
     }
    },
    "type": "object",
    "required": [
     "key",
     "name",
     "description",
     "type",
     "groups",
     "source",
     "offered"
    ],
    "title": "DictionaryField"
   },
