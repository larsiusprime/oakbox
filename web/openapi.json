    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "filename": {
      "type": "string",
      "title": "Filename"
     },
     "layer": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Layer"
     },
     "format": {
      "type": "string",
      "title": "Format"
     },
     "size_bytes": {
      "type": "integer",
      "title": "Size Bytes",
      "description": "0 when the file is missing from in/."
     }
