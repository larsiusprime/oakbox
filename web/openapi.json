   "NewProject": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name",
      "description": "Project name; also the folder name. Free text."
     },
     "country": {
      "type": "string",
      "title": "Country",
      "description": "ISO 3166-1 alpha-2 code, e.g. 'US'."
     },
     "region": {
      "type": "string",
      "title": "Region",
      "description": "For the US, an ISO 3166-2 state code without 'US-' (e.g. 'TX'); else free text."
     },
     "jurisdiction": {
      "type": "string",
      "title": "Jurisdiction",
      "description": "What the office calls itself; OpenAVMKit's locality.name."
     },
     "tax_year": {
      "type": "integer",
      "title": "Tax Year"
     },
     "valuation_date": {
      "type": "string",
      "format": "date",
      "title": "Valuation Date"
     },
     "units": {
      "type": "string",
      "enum": [
       "imperial",
       "metric"
      ],
      "title": "Units"
     }
