 "components": {
  "schemas": {
   "AddFile": {
    "properties": {
     "path": {
      "type": "string",
      "title": "Path"
     },
     "mode": {
      "type": "string",
      "enum": [
       "move",
       "copy"
      ],
      "title": "Mode"
     },
     "name": {
      "type": "string",
      "title": "Name",
      "description": "The data.load key."
     },
     "layer": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Layer"
     },
     "filename": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Filename",
      "description": "A new name in in/, when the original is taken."
     }
    },
    "type": "object",
    "required": [
     "path",
     "mode",
     "name"
    ],
    "title": "AddFile"
   },
   "AppSettingsView": {
