      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Layer",
      "description": "GeoPackage layer."
     }
    },
    "type": "object",
    "required": [
     "name",
     "filename",
     "layer"
    ],
    "title": "DataFile",
    "description": "One data.load entry, as OAK box wrote it."
   },
