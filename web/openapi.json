      "default": "US"
     },
     "region": {
      "type": "string",
      "title": "Region",
      "default": ""
     },
     "jurisdiction": {
      "type": "string",
      "title": "Jurisdiction",
      "default": ""
     },
     "tax_year": {
      "type": "integer",
